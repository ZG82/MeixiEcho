# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Windows installers are packaged from the validated local build output, not source-controlled.
/public/downloads/*.exe

# Existing campaign media remains available in the validated deployment archive.
# Track only the newly authored final-chapter poster with this site source revision.
/public/media/*
!/public/media/meixi-echo-chapter-three-final-poster.png
/poster/assets/*
